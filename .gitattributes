# Normalize line endings so Windows contributions do not rewrite whole files.
* text=auto eol=lf

# Windows-only scripts keep CRLF so cmd.exe/PowerShell ISE stay happy.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts must stay LF or they fail to exec inside the container.
*.sh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary assets must never be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.gz binary
*.tgz binary
*.exe binary

# Keep the license text verbatim; GPL tooling compares it byte for byte.
LICENSE -text
