# Copy to .env.local before `pnpm build` to rebrand your deployment.
# All values are optional; the defaults point at the Cloudreve-New repository.

# Repository used by the admin dashboard links and "learn more" buttons.
VITE_REPO_URL=
# Optional home page / documentation overrides.
VITE_HOME_URL=
VITE_DOCS_URL=
VITE_DISCUSSION_URL=
# Optional community links; leave empty to hide them.
VITE_DISCORD_URL=
VITE_TELEGRAM_URL=

# Optional Giscus announcement board (leave empty to show "no announcements").
VITE_GISCUS_REPO=
VITE_GISCUS_REPO_ID=
VITE_GISCUS_CATEGORY=
VITE_GISCUS_CATEGORY_ID=
